registry=https://registry.npmmirror.com/
# 指向已存在的全局 pnpm store，避免 store-dir 相对路径解析异常
store-dir = "D:\.pnpm-store\v11"

# 强制提升所有依赖到扁平的 node_modules
# 模拟 npm/yarn 的结构，避免路径解析问题
shamefully-hoist = true

# 严格模式下不检查 peer 依赖版本（避免很多不必要的警告）
strict-peer-dependencies = false

# 自动安装 peer 依赖
auto-install-peers = true

# 解决 windows 路径过长问题（如果文件路径超过 260 字符）
node-linker = hoisted
