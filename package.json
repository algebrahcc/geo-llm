{
  "name": "geo-llm",
  "version": "2.2.0",
  "description": "Geo-LLM assisted decision prototype system. 基于 Vue3、Vite、TypeScript、NaiveUI、UnoCSS 的地理大模型辅助决策原型系统。",
  "keywords": [
    "TypeScript",
    "UnoCSS",
    "Vite8",
    "Vue3 admin ",
    "ant-design-vue v4",
    "naive-ui",
    "naive-ui-admin",
    "vue-admin-template"
  ],
  "homepage": "https://github.com/algebrahcc/geo-llm",
  "bugs": {
    "url": "https://github.com/algebrahcc/geo-llm/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Geo-LLM"
  },
  "repository": {
    "url": "https://github.com/algebrahcc/geo-llm.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "fmt": "oxfmt",
    "gen-route": "sa gen-route",
    "lint": "oxlint --fix && eslint --fix .",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "sa release",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.1",
    "@photo-sphere-viewer/compass-plugin": "^5.15.1",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@sa/axios": "2.2.0",
    "@sa/color": "2.2.0",
    "@sa/hooks": "2.2.0",
    "@sa/materials": "2.2.0",
    "@sa/utils": "2.2.0",
    "@vueuse/core": "14.3.0",
    "cesium": "1.141.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.20",
    "defu": "6.1.7",
    "echarts": "6.0.0",
    "echarts-wordcloud": "^2.1.0",
    "jsencrypt": "^3.5.4",
    "json5": "2.2.3",
    "mvt-imagery-provider": "^1.0.3",
    "naive-ui": "2.44.1",
    "nprogress": "0.2.0",
    "ol": "^10.9.0",
    "pinia": "3.0.4",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.34",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.472",
    "@iconify/utils": "^2",
    "@sa/scripts": "2.2.0",
    "@sa/uno-preset": "2.2.0",
    "@soybeanjs/eslint-config-vue": "^0.0.2",
    "@types/node": "25.7.0",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "consola": "3.4.2",
    "eslint": "10.3.0",
    "kolorist": "1.8.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "sass": "1.99.0",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "unocss": "^66.6.8",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "8.0.12",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.1.2",
    "vite-plugin-vue-transition-root-validator": "^0.1.0",
    "vue-tsc": "3.2.8"
  },
  "simple-git-hooks": {
    "commit-msg": "npx sa git-commit-verify",
    "pre-commit": "npm run typecheck && npm run lint && npm run fmt && git diff --exit-code"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "website": ""
}
