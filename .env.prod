# backend service base url, prod environment
VITE_SERVICE_BASE_URL=https://mock.apifox.cn/m1/3109515-0-default

# 真实后端地址（登录 / 系统管理 / AI 流式 / 瓦片 / 导出）：
# 生产构建默认走同源 /api，由 Nginx 转发给后端（见 deploy/nginx/default.conf）。
# 部署到具体机器时，仍可用 dist/config.json 的 VITE_SERVICE_REAL_BASE_URL 运行时覆盖，无需重新打包。
VITE_SERVICE_REAL_BASE_URL=/api

# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9529"
}`

# Mock mode disabled in production
VITE_HTTP_MOCK=N
# Do NOT set VITE_APIFOX_TOKEN in production
